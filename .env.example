# Copy to .env and fill in by hand. .env is git-ignored. Never paste these into chat.

# Needed only for live agents (STUDIO_LLM=live). The demo runs without it.
ANTHROPIC_API_KEY=

# Needed only for the real Telegram bot (npm run studio). Created with BotFather.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id. The bot ignores everyone else.
TELEGRAM_OWNER_ID=

# Needed only for real brand images (STUDIO_IMAGES=live). Brand runs without it using placeholder art.
GEMINI_API_KEY=
# mock (default, free, placeholder art) or live (calls Gemini, costs money)
STUDIO_IMAGES=mock
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Your estimate of what one image costs. Used for the plan and the cap. Check your own Gemini pricing.
GEMINI_COST_PER_IMAGE_USD=0.05
# Most images one job may generate.
BRAND_MAX_IMAGES=12

# mock (default, free, offline) or live (calls Anthropic, costs money)
STUDIO_LLM=mock
STUDIO_MODEL=claude-sonnet-5-5
# Hard stop per job, in US dollars.
STUDIO_MAX_USD=1

# Where Moon lives and which Chrome to drive.
MOON_PATH=~/2026/moon-design-system
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Audits. They only read: they load a page, measure it and never click or log in.
# Set to 1 to let audits open pages on this machine, such as a dev server on localhost.
AUDIT_ALLOW_LOCALHOST=0
# Extra folders audits may read local HTML and screenshots from, comma separated. out/ and samples/ are always allowed.
AUDIT_FILE_ROOTS=
