<script>
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var qs = function (s, r) { return (r || document).querySelector(s); };
  var qa = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  // ---- hero shapes follow the pointer a little ----
  var hero = qs('.hero');
  if (hero && !reduce) hero.addEventListener('pointermove', function (e) {
    var r = hero.getBoundingClientRect();
    hero.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
    hero.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
  });

  // ---- the pinned story ----
  var track = qs('#track'), beats = qa('.beat'), box = qs('#stagebox'), dots = qs('#dots');
  var N = beats.length, cur = -1;
  var scenes = beats.map(function (b) { return qs('.scene', b); });
  scenes.forEach(function (s) { s.classList.add('s'); box.appendChild(s); });
  beats.forEach(function (b, i) {
    var d = document.createElement('button');
    d.type = 'button'; d.setAttribute('aria-label', 'Go to step ' + (i + 1) + ' of ' + N);
    d.addEventListener('click', function () { goStep(i); });
    dots.appendChild(d);
  });
  var dotBtns = qa('button', dots);
  var typedEl = qs('#typed'), typedFull = typedEl ? typedEl.textContent : '', typeTimer = null;
  function typeIn() {
    if (!typedEl) return;
    clearInterval(typeTimer);
    if (reduce) { typedEl.textContent = typedFull; return; }
    var i = 0; typedEl.innerHTML = '<span class="caret"></span>';
    typeTimer = setInterval(function () {
      i += 2; typedEl.textContent = typedFull.slice(0, i);
      var c = document.createElement('span'); c.className = 'caret'; typedEl.appendChild(c);
      if (i >= typedFull.length) { clearInterval(typeTimer); typedEl.textContent = typedFull; }
    }, 28);
  }
  function setStep(i) {
    if (i === cur) return;
    cur = i;
    beats.forEach(function (b, n) { b.classList.toggle('on', n === i); });
    scenes.forEach(function (s, n) { s.classList.toggle('on', n === i); });
    dotBtns.forEach(function (d, n) { d.classList.toggle('on', n === i); d.setAttribute('aria-current', n === i ? 'step' : 'false'); });
    if (i === 0) typeIn();
  }
  function progress() {
    var r = track.getBoundingClientRect(), vh = window.innerHeight;
    var p = (-r.top) / Math.max(1, r.height - vh);
    return Math.min(0.9999, Math.max(0, p));
  }
  function onScroll() { setStep(Math.min(N - 1, Math.floor(progress() * N))); }
  function goStep(i) {
    var top = track.getBoundingClientRect().top + window.scrollY, vh = window.innerHeight;
    window.scrollTo({ top: top + (i + 0.5) * ((track.offsetHeight - vh) / N), behavior: reduce ? 'auto' : 'smooth' });
  }
  var ticking = false;
  window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(function () { ticking = false; onScroll(); }); } }, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll(); if (cur < 0) setStep(0);

  // ---- tilt on the work cards ----
  if (!reduce && window.matchMedia('(hover:hover)').matches) {
    qa('[data-tilt]').forEach(function (el) {
      el.addEventListener('pointermove', function (e) {
        var r = el.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = 'perspective(900px) rotateY(' + (x * 8).toFixed(2) + 'deg) rotateX(' + (-y * 8).toFixed(2) + 'deg) translateY(-6px)';
      });
      el.addEventListener('pointerleave', function () { el.style.transform = ''; });
    });
  }

  // ---- the contrast toy, on the real Moon tokens ----
  var root = getComputedStyle(document.documentElement);
  var hex = function (n) { return root.getPropertyValue('--' + n).trim(); };
  var lum = function (h) { var n = parseInt(h.slice(1), 16), c = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map(function (v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
  var ratio = function (a, b) { var x = lum(a), y = lum(b), hi = Math.max(x, y), lo = Math.min(x, y); return (hi + 0.05) / (lo + 0.05); };
  var ramp = ['mo-black', 'mo-grey-9', 'mo-grey-8', 'mo-grey-7', 'mo-grey-6', 'mo-grey-5', 'mo-grey-4', 'mo-grey-3'];
  var rampEl = qs('#ramp'), aa = qs('#aa'), st = qs('#st'), tokEl = qs('#tok'), ratioEl = qs('#ratio'), needEl = qs('#need'), sizeBtn = qs('#size');
  var large = false, lastOk = true;
  function toy() {
    var token = ramp[Number(rampEl.value)], r = ratio(hex(token), hex('mo-grey-1')), min = large ? 3 : 4.5, ok = r >= min;
    aa.style.color = 'var(--' + token + ')';
    aa.style.fontSize = large ? '144px' : '96px';
    tokEl.textContent = token;
    ratioEl.textContent = (Math.round(r * 100) / 100).toFixed(2) + ':1';
    needEl.textContent = (large ? 'Large text' : 'Normal text') + ' needs ' + min + ' to 1.';
    st.textContent = ok ? 'PASS' : 'REJECTED';
    st.className = 'st' + (ok ? '' : ' bad') + (ok !== lastOk ? ' slam' : '');
    lastOk = ok;
  }
  rampEl.addEventListener('input', toy);
  sizeBtn.addEventListener('click', function () { large = !large; sizeBtn.setAttribute('aria-pressed', String(large)); sizeBtn.textContent = large ? 'Treat it as normal text' : 'Treat it as large text'; toy(); });
  toy();

  // ---- audit pins ----
  var pins = qa('#auditscreen .pin'), boxes = qa('#auditscreen .box'), finds = qa('#finds li'), fc = 0;
  function pick(i) {
    fc = (i + finds.length) % finds.length;
    finds.forEach(function (f, n) { f.classList.toggle('on', n === fc); });
    pins.forEach(function (p, n) { p.classList.toggle('on', n === fc); p.setAttribute('aria-pressed', String(n === fc)); });
    boxes.forEach(function (b, n) { b.classList.toggle('on', n === fc); });
  }
  pins.forEach(function (p, n) { p.addEventListener('click', function () { pick(n); }); });
  if (qs('#fprev')) qs('#fprev').addEventListener('click', function () { pick(fc - 1); });
  if (qs('#fnext')) qs('#fnext').addEventListener('click', function () { pick(fc + 1); });
  if (finds.length) pick(0);

  // ---- reveals and the terminal ----
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); if (e.target.id === 'term') e.target.classList.add('go'); io.unobserve(e.target); } }); }, { threshold: 0.12 });
    qa('.rise').forEach(function (el) { io.observe(el); });
  } else { qa('.rise').forEach(function (el) { el.classList.add('in', 'go'); }); }

  // ---- copy ----
  var copyBtn = qs('#copy'), copied = qs('#copied');
  copyBtn.addEventListener('click', function () {
    var text = 'npm install\nnpm run demo\nnpm run demo:brand\nnpm run demo:audit\nnpm test';
    var done = function () { copied.textContent = 'Copied.'; }, fail = function () { copied.textContent = 'Select the commands above and copy them.'; };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fail); else fail();
  });
})();
</script>
